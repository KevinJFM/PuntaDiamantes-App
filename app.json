{
  "expo": {
    "name": "Punta Diamantes",
    "slug": "puntadiamantes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-pd.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puntadiamantes.app"
    },
    "android": {
      "package": "com.puntadiamantes.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E5388A",
        "foregroundImage": "./assets/adaptive-pd.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#E5388A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1c023db4-6648-480f-8642-6b6de62d1290"
      }
    },
    "owner": "puntadiamantes"
  }
}
